{
  "name": "moonpetal-apothecary",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "start:lan": "expo start --lan",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "npx expo-doctor",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "levels:generate": "node scripts/gen-levels.mjs",
    "sim": "tsx tools/simulator/cli.ts",
    "sim:strict": "tsx tools/simulator/cli.ts --strict",
    "sim:one": "tsx tools/simulator/cli.ts --level"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.2.12",
    "expo": "~54.0.0",
    "expo-audio": "~1.1.1",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-worklets": "0.5.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0"
  },
  "overrides": {
    "babel-preset-expo": "~54.0.10",
    "react-native-worklets": "0.5.1"
  }
}
